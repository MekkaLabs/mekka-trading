# =============================================================================
# Mekka Trading — .gitignore
# Projeto híbrido: TypeScript/Node + Python + Obsidian
# =============================================================================

# ----- Segredos e variáveis de ambiente (NUNCA COMMITAR) -----
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
secrets/
credentials/

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# ----- Windows -----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Linux -----
*~
.fuse_hidden*
.directory
.Trash-*

# =============================================================================
# Node / TypeScript
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
develop-eggs/
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Testing
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.hypothesis/
nosetests.xml
coverage.xml

# Type checkers / Linters
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/

# =============================================================================
# IDEs / Editores
# =============================================================================
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.cursor/
.antigravity/

# =============================================================================
# Logs e dados runtime do projeto
# =============================================================================
logs/
*.log
*.log.*
npm-debug.log*

# Memory / Audit trail (dados gerados em runtime)
memory/audit-log/*.jsonl
memory/alerts/*.jsonl
memory/reports/*.json
!memory/audit-log/.gitkeep
!memory/alerts/.gitkeep
!memory/reports/.gitkeep

# Observability (dados gerados em runtime)
observability/store/*.jsonl
observability/store/*.db
observability/alerts/*.jsonl
observability/reports/*.json
!observability/store/.gitkeep
!observability/alerts/.gitkeep
!observability/reports/.gitkeep

# =============================================================================
# Arquivos pesados / Backups
# =============================================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.backup
*.old
squads.zip

# =============================================================================
# Obsidian — vault em /docs/obsidian
# =============================================================================
# Ignorar workspace e cache, mas manter notas e config compartilhada
docs/obsidian/.obsidian/workspace.json
docs/obsidian/.obsidian/workspace-mobile.json
docs/obsidian/.obsidian/workspaces.json
docs/obsidian/.obsidian/cache/
docs/obsidian/.trash/

# =============================================================================
# Dados de mercado / Backtesting (artefatos pesados)
# =============================================================================
backtesting/data/*.csv
backtesting/data/*.parquet
backtesting/results/*.json
!backtesting/data/.gitkeep
!backtesting/results/.gitkeep
*.parquet
*.feather
data/raw/
data/processed/

# =============================================================================
# Submódulo aiox-core
# =============================================================================
# aiox-core é um repositório Git independente (https://github.com/SynkraAI/aiox-core).
# Idealmente, adicionar como submódulo:
#   git submodule add https://github.com/SynkraAI/aiox-core.git aiox-core
# Por enquanto, ignorar para não duplicar histórico no repo principal.
aiox-core/

# =============================================================================
# Limpeza pós-bootstrap (remover manualmente quando seguro)
# =============================================================================
_aiox-core-clone-tmp/
_git-broken-tmp/
_git-broken-tmp*/
_git-stale-tmp*/

# =============================================================================
# Outras temporários
# =============================================================================
tmp/
temp/
.cache/
.env.save
.env

# Runtime data — não versionar
data/dashboard_snapshots/
data/mekka_trading.db
data/mekka_trading.db-shm
data/mekka_trading.db-wal
.agent-os/
