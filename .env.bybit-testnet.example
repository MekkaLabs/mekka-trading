# ==============================================================================
# Mekka Trading — Bybit Testnet Environment
# Copy to .env only when you want to run against Bybit testnet.
# ==============================================================================

# --- LLM ---
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional Claude fallback
ANTHROPIC_API_KEY=

# --- Exchange Selection ---
ACTIVE_EXCHANGE=bybit

# Reused as the global environment switch for CCXT sandbox/testnet mode.
# Keep this as "testnet" for Bybit sandbox runs.
HYPERLIQUID_NETWORK=testnet

# Hyperliquid credentials stay unset when Bybit is the active exchange.
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# --- Bybit Testnet API ---
BYBIT_API_KEY=your-bybit-testnet-api-key
BYBIT_API_SECRET=your-bybit-testnet-api-secret

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime Mode ---
PAPER_TRADING=false
LIVE_TRADING_CONFIRMED=false

# --- Assets ---
TRADING_ASSETS=BTC

# --- Conservative Risk for First Exchange Test ---
MAX_POSITION_SIZE_PCT=0.005
MAX_LEVERAGE=2
MAX_TRADES_PER_DAY=3
MAX_OPEN_POSITIONS=1
MAX_TOTAL_CAPITAL_PCT=0.05
MAX_TOTAL_NOTIONAL_USD=100
MAX_DAILY_DRAWDOWN_PCT=0.05

# --- Operational Toggles ---
VISION_CRITIC_ENABLED=false
TELEGRAM_TRADE_APPROVAL_ENABLED=true
TELEGRAM_TRADE_APPROVAL_TIMEOUT_S=30
LOG_LEVEL=INFO
