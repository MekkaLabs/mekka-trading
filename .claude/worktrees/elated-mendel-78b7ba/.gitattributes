# Normalização de fim de linha
* text=auto eol=lf

# Arquivos texto explícitos
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.sh        text eol=lf

# Binários
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
*.parquet   binary

# Linguagens detectáveis (GitHub Linguist)
docs/**     linguist-documentation
tests/**    linguist-vendored=false
*.md        linguist-detectable=true
