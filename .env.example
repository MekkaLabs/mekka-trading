# ==============================================================================
# Mekka Trading — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ==============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Prometheus (engenharia de prompts, opcional) ---
# Habilita persistência do catálogo de prompts em data/prompts/catalog.json.
# Sem efeito no trading loop — Prometheus opera offline via scripts/prometheus_cli.py.
# Default: false (auditoria sempre disponível, só registro no catálogo é opt-in).
PROMETHEUS_CATALOG_ENABLED=false

# ==============================================================================
# Exchange Selection
# ==============================================================================
# Which exchange to use for market data (Superman) and live execution (IronMan).
# Allowed values: hyperliquid | bybit | binance
# Default: hyperliquid
#
# When set, ONLY the credentials of the active exchange are required at boot.
# Inactive exchanges' credential fields may be left blank.
ACTIVE_EXCHANGE=hyperliquid

# --- Hyperliquid ---
# Required when ACTIVE_EXCHANGE=hyperliquid. Leave blank otherwise.
# Your EVM wallet private key (without 0x prefix is fine)
HYPERLIQUID_PRIVATE_KEY=your-private-key-hex-here
# Your EVM wallet address (0x...)
HYPERLIQUID_WALLET_ADDRESS=0xYourWalletAddressHere
# "testnet" or "mainnet"
HYPERLIQUID_NETWORK=testnet

# --- Bybit (Story 047 — multi-exchange via CCXT) ---
# Required when ACTIVE_EXCHANGE=bybit. Leave blank otherwise.
#
# HOW TO GET TESTNET KEYS:
#   1. Go to https://testnet.bybit.com and sign up (separate from mainnet account).
#   2. Settings → API Management → Create New Key → System-generated → Read+Trade.
#      IMPORTANT: enable "Unified Trading Account" permissions, including
#      Contract / Derivatives Trade. Without it, perp orders return 10003.
#   3. Claim testnet USDT from the faucet (top-right menu → Testnet Faucet).
#   4. Paste the API key/secret below.
#   5. Set BYBIT_TESTNET=true (this is also the default — see set_sandbox_mode).
BYBIT_API_KEY=
BYBIT_API_SECRET=
# When true, the CCXT client routes to api-testnet.bybit.com and
# stream-testnet.bybit.com via exchange.set_sandbox_mode(True).
# Default: true (safe-by-default — never accidentally hit mainnet).
BYBIT_TESTNET=true

# --- Binance (Story 047 — multi-exchange via CCXT) ---
# Required when ACTIVE_EXCHANGE=binance. Leave blank otherwise.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Same safety pattern as BYBIT_TESTNET above.
BINANCE_TESTNET=true

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# --- News & Sentiment ---
CRYPTOPANIC_API_KEY=your-cryptopanic-api-key-here

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Paper Trading ---
# Set to "true" to use paper trading (no real orders placed). Default: true
PAPER_TRADING=true

# --- Assets to Trade ---
# Comma-separated list of Hyperliquid symbols (no USDT suffix needed)
TRADING_ASSETS=BTC,ETH,SOL

# --- Risk Management ---
# Maximum position size as a fraction of equity (e.g. 0.02 = 2%)
MAX_POSITION_SIZE_PCT=0.02
# Maximum allowed leverage per trade
MAX_LEVERAGE=5
# Maximum daily drawdown before halting trading (e.g. 0.10 = 10%)
MAX_DAILY_DRAWDOWN_PCT=0.10

# --- Portfolio Manager ---
# Synthetic equity used when paper_trading=True and Hyperliquid is unreachable.
# Portfolio Manager falls back to this so Batman never validates against zero.
PAPER_EQUITY_USD=10000.0

# --- Safety Net (Story 029a) ---
# Maximum total notional across all open positions, as fraction of equity (0.10 = 10%)
MAX_TOTAL_CAPITAL_PCT=0.10
# Optional absolute USD cap on total notional. Leave empty for "no absolute cap".
# Recommended for first weeks of testnet (e.g. 500.0)
# MAX_TOTAL_NOTIONAL_USD=500.0
# Engage kill switch after N consecutive Iron Man ERROR executions
MAX_CONSECUTIVE_EXEC_ERRORS=3
# Engage kill switch after N consecutive Vision HOLD-fallbacks (LLM degraded)
MAX_CONSECUTIVE_VISION_FALLBACKS=5

# ==============================================================================
# Quick-Start Profiles
# ==============================================================================
# Pick ONE block below and uncomment/copy into your .env. Do NOT keep multiple
# ACTIVE_EXCHANGE lines uncommented — the last one wins, silently.
#
# --- Profile 1: Hyperliquid testnet (paper) — original default ---
# ACTIVE_EXCHANGE=hyperliquid
# HYPERLIQUID_NETWORK=testnet
# PAPER_TRADING=true
# HYPERLIQUID_PRIVATE_KEY=<your hex pk>
# HYPERLIQUID_WALLET_ADDRESS=0x<your address>
#
# --- Profile 2: Bybit testnet (paper) — recommended first-time setup ---
# ACTIVE_EXCHANGE=bybit
# BYBIT_TESTNET=true
# PAPER_TRADING=true
# BYBIT_API_KEY=<your testnet api key>
# BYBIT_API_SECRET=<your testnet api secret>
# TRADING_ASSETS=BTC,ETH,SOL
#
# --- Profile 3: Bybit testnet (LIVE on testnet — small notional) ---
# ACTIVE_EXCHANGE=bybit
# BYBIT_TESTNET=true
# PAPER_TRADING=false
# LIVE_TRADING_CONFIRMED=true        # double opt-in REQUIRED when PAPER_TRADING=false
# BYBIT_API_KEY=<your testnet api key>
# BYBIT_API_SECRET=<your testnet api secret>
# MAX_POSITION_SIZE_PCT=0.005        # 0.5% — keep tiny on first live runs
# MAX_LEVERAGE=2                     # 2x — keep tiny on first live runs
# MAX_TOTAL_NOTIONAL_USD=100.0       # hard cap regardless of pct math
